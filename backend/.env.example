# Server Configuration
PORT=5000
NODE_ENV=production

# Security & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key

# Amazon RDS / PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:YourSecurePassword@sales-tracker-rds.c123456789.us-east-1.rds.amazonaws.com:5432/postgres

# AWS Ecosystem Credentials & Bucket Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=csbc252-sales-tracker-assets

# Note: On EC2 instances, credentials can be automatically fetched from IAM Role Instance Profiles.
# If testing locally, provide explicit IAM user keys:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# CloudWatch Logging Configuration
CLOUDWATCH_LOG_GROUP=/aws/ec2/sales-app-tracker
CLOUDWATCH_LOG_STREAM=backend-api-stream
ENABLE_CLOUDWATCH=true
