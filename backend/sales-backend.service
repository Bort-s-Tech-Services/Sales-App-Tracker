[Unit]
Description=Sales Tracker Pro Backend Service (CSBC 252 Capstone)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/var/www/sales-tracker/backend
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=sales-tracker-backend
Environment=NODE_ENV=production PORT=5000

[Install]
WantedBy=multi-user.target
